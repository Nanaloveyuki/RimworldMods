<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>PWM_WashingMachine</defName>
    <label>washing machine</label>
    <description>An electric washing machine that removes the dead-person flag from apparel without repairing it. Each cycle takes 30 game seconds. Creatures small enough to fit can also be washed, although they are unlikely to enjoy it.</description>
    <thingClass>WashingMachine.Building_WashingMachine</thingClass>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <graphicData>
      <texPath>Things/Building/WashingMachine/WashingMachine</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shaderType>Cutout</shaderType>
    </graphicData>
    <size>(1,1)</size>
    <rotatable>true</rotatable>
    <passability>PassThroughOnly</passability>
    <pathCost>40</pathCost>
    <fillPercent>0.7</fillPercent>
    <blockWind>true</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>1800</WorkToBuild>
      <Mass>40</Mass>
      <Flammability>0.4</Flammability>
      <Beauty>-1</Beauty>
    </statBases>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <building>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
    </building>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
    <uiOrder>2150</uiOrder>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
  </ThingDef>
</Defs>
