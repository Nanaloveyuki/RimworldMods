<Project>
  <PropertyGroup>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == '' and '$(RIMWORLD_VERSION)' != ''">$(RIMWORLD_VERSION)</RimWorldVersion>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.7</RimWorldVersion>
    <RimWorldDir Condition="'$(RimWorldDir)' == '' and '$(RIMWORLD_DIR)' != ''">$(RIMWORLD_DIR)</RimWorldDir>
    <RimWorldDir Condition="'$(RimWorldDir)' == '' and '$(OS)' == 'Windows_NT'">E:/Apps/Steam/steamapps/common/RimWorld</RimWorldDir>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">/mnt/e/Apps/Steam/steamapps/common/RimWorld</RimWorldDir>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == '' and '$(RimWorldVersion)' == '1.7'">$(RimWorldDir)</RimWorldManagedDir>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == ''">$(RimWorldDir)/RimWorldWin64_Data/Managed</RimWorldManagedDir>
    <OxygenDslDir Condition="'$(OxygenDslDir)' == ''">$(MSBuildThisFileDirectory)../oxygen_dsl_framework</OxygenDslDir>
    <OxygenDslBuildDir Condition="'$(RimWorldVersion)' == '1.7'">$(OxygenDslDir)/tmp/build/1.7</OxygenDslBuildDir>
    <OxygenDslBuildDir Condition="'$(RimWorldVersion)' == '1.6'">$(OxygenDslDir)/tmp/build</OxygenDslBuildDir>
    <DefineConstants Condition="'$(RimWorldVersion)' == '1.7'">$(DefineConstants);RIMWORLD_1_7</DefineConstants>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <Target Name="CheckRimWorldVersion" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RimWorldVersion)' != '1.6' and '$(RimWorldVersion)' != '1.7'" Text="RimWorldVersion must be 1.6 or 1.7." />
    <Error Condition="!Exists('$(RimWorldManagedDir)/Assembly-CSharp.dll')" Text="Missing game assembly: $(RimWorldManagedDir)/Assembly-CSharp.dll. Set RimWorldDir to the matching game installation." />
    <Error Condition="'$(RimWorldVersion)' == '1.7' and !Exists('$(RimWorldManagedDir)/UnityStubs.dll')" Text="RimWorld 1.7 requires UnityStubs.dll at the game root." />
  </Target>
</Project>
