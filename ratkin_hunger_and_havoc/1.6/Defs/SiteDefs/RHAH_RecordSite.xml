<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <WorldObjectDef ParentName="StaticWorldObjectBase">
    <defName>RHAH_RecordSite</defName>
    <label>旧存放点</label>
    <worldObjectClass>Site</worldObjectClass>
    <mapGenerator>RHAH_RecordSite</mapGenerator>
    <expandingIcon>true</expandingIcon>
    <comps>
      <li Class="WorldObjectCompProperties_FormCaravan" />
      <li Class="WorldObjectCompProperties_EnterCooldown" />
    </comps>
    <IncidentTargetTags><li>Map_Misc</li></IncidentTargetTags>
  </WorldObjectDef>
  <SitePartDef>
    <defName>RHAH_RecordSite</defName>
    <label>旧存放点</label>
    <description>一处旧存放点，留下的箱子里放着搬运清单和受潮的纸。</description>
    <siteTexture>World/WorldObjects/DefaultSettlement</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/ItemStash</expandingIconTexture>
    <disallowsAutomaticDetectionTimerStart>true</disallowsAutomaticDetectionTimerStart>
    <considerEnteringAsAttack>false</considerEnteringAsAttack>
  </SitePartDef>
  <MapGeneratorDef>
    <defName>RHAH_RecordSite</defName>
    <genSteps>
      <li>ElevationFertility</li>
      <li>Terrain</li>
      <li>RocksFromGrid_NoMinerals</li>
      <li>FindPlayerStartSpot</li>
      <li>Plants</li>
      <li>Snow</li>
      <li>Animals</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>
  <LetterDef>
    <defName>RHAH_RecordLetter</defName>
    <color>(168, 160, 132)</color>
    <flashColor>(168, 160, 132)</flashColor>
    <flashInterval>90</flashInterval>
    <arriveSound>LetterArrive</arriveSound>
  </LetterDef>
</Defs>
