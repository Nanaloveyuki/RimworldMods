<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>RHAH_RefeedingSyndrome</defName>
    <label>再喂养综合征</label>
    <description>长期挨饿后，短时间内吃进大量食物，引起体液中的电解质失衡。消化、血液滤毒和意识都会暂时下降，几天后会自行恢复。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120000~300000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Metabolism</capacity>
            <offset>-0.30</offset>
          </li>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>-0.20</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.25</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
