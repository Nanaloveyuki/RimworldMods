  <QuestScriptDef>
    <defName>RHAH_RefugeeMassacre</defName><label>Dangerous ratkin settlement</label>
    <root Class="HungerAndHavoc.Incidents.QuestNode_RHAH_RefugeeCamp" />
    <expireDaysRange>15</expireDaysRange>
    <questNameRules>
      <rulesStrings>
        <li>questName->清掉鼠族营地</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->[sponsorName]说附近有一处鼠族临时营地，可能威胁他们的定居点。他们要你在 [campDays] 天内杀掉那里的全部灾民，以防止他们所说的“鼠灾狂潮”。完成后，双方好感变化 [campGoodwill] 点。\n\n营地预计有 [campMinAdults] 到 [campMaxAdults] 名成年鼠族，以及 [campMinChildren] 到 [campMaxChildren] 名鼠蛋。没有炮台，也没有电力，但大人可能带着武器，附近也可能出现捕食者。只击倒或俘虏，不算完成。</li>
      </rulesStrings>
    </questDescriptionRules>
  </QuestScriptDef>
  <WorldObjectDef ParentName="StaticWorldObjectBase">
    <defName>RHAH_RefugeeCamp</defName>
    <label>临时安居点</label>
    <worldObjectClass>HungerAndHavoc.Incidents.WorldObject_RHAH_RefugeeCamp</worldObjectClass>
    <mapGenerator>RHAH_RefugeeCamp</mapGenerator>
    <expandingIcon>true</expandingIcon>
    <comps>
      <li Class="WorldObjectCompProperties_FormCaravan" />
      <li Class="WorldObjectCompProperties_EnterCooldown" />
    </comps>
    <IncidentTargetTags><li>Map_Misc</li></IncidentTargetTags>
  </WorldObjectDef>
  <SitePartDef>
    <defName>RHAH_RefugeeCamp</defName>
    <label>临时安居点</label>
    <description>一群鼠族在这处营地搭了木屋。</description>
    <siteTexture>World/WorldObjects/DefaultSettlement</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Camp</expandingIconTexture>
    <disallowsAutomaticDetectionTimerStart>true</disallowsAutomaticDetectionTimerStart>
    <considerEnteringAsAttack>false</considerEnteringAsAttack>
  </SitePartDef>
  <MapGeneratorDef>
    <defName>RHAH_RefugeeCamp</defName>
    <genSteps>
      <li>ElevationFertility</li>
      <li>Terrain</li>
      <li>RocksFromGrid_NoMinerals</li>
      <li>RHAH_RefugeeCamp</li>
      <li>FindPlayerStartSpot</li>
      <li>Plants</li>
      <li>Snow</li>
      <li>Animals</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>
  <GenStepDef>
    <defName>RHAH_RefugeeCamp</defName>
    <order>450</order>
    <genStep Class="HungerAndHavoc.Incidents.GenStep_RHAH_RefugeeCamp" />
  </GenStepDef>
</Defs>
