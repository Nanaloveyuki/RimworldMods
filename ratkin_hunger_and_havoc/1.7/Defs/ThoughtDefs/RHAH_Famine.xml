<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThoughtDef>
    <defName>RHAH_Thought_ClaySatiety</defName>
    <workerClass>HungerAndHavoc.Pawn.ThoughtWorker_RHAH_ClaySatiety</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>吃了观音土</label>
        <description>我吞下了观音土。肚子里有东西了，可我还是想吃饭。</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
      <li>
        <label>又吃了观音土</label>
        <description>又吞了一份土，肚子撑得难受。我想吃的不是这个。</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
      <li>
        <label>吃够了观音土</label>
        <description>我已经吃了好几份土，嘴里到现在还有土腥味。别再让我吃这个了吱。</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RHAH_Thought_FamineHunger</defName>
    <workerClass>HungerAndHavoc.Pawn.ThoughtWorker_RHAH_FamineHunger</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>还在挨饿</label>
        <description>我饿了吱，肚子饿得难受。</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
      <li>
        <label>求食落空</label>
        <description>我饿了吱，求过吃的也没等来一口饭。</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RHAH_Thought_FamineFed</defName>
    <thoughtClass>HungerAndHavoc.Pawn.Thought_Memory_RHAH_FamineFed</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>总算吃饱了</label>
        <description>这顿饭让我吃饱了。总算不用一直惦记着空肚子了吱。</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RHAH_Thought_Sheltered</defName>
    <thoughtClass>HungerAndHavoc.Pawn.Thought_Memory_RHAH_FamineFed</thoughtClass>
    <durationDays>24</durationDays>
    <stackLimit>1</stackLimit>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>我被收留了吱,开心!</label>
        <description>他们愿意让我留下来了吱！总算有个落脚的地方了。</description>
        <baseMoodEffect>12</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RHAH_Thought_Captured</defName>
    <thoughtClass>HungerAndHavoc.Pawn.Thought_Memory_RHAH_FamineFed</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>被塞进囚笼里了吱...</label>
        <description>他们把我关起来了吱……我想出去。</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RHAH_Thought_EnslavedFed</defName>
    <thoughtClass>HungerAndHavoc.Pawn.Thought_Memory_RHAH_FamineFed</thoughtClass>
    <durationDays>24</durationDays>
    <stackLimit>1</stackLimit>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>有饭吃唧...</label>
        <description>要给主人干活了……可这里有饭吃，至少不用饿着了唧。</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RHAH_Thought_EnslavedServing</defName>
    <thoughtClass>HungerAndHavoc.Pawn.Thought_Memory_RHAH_EnslavedServing</thoughtClass>
    <stackLimit>1</stackLimit>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>要去服侍主人吱...</label>
        <description>以后得听主人的话，给主人干活了吱……我不想被人使唤。</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RHAH_Thought_Expelled</defName>
    <thoughtClass>HungerAndHavoc.Pawn.Thought_Memory_RHAH_FamineFed</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>被赶走惹</label>
        <description>他们把我赶走了吱……我还能去哪儿呢？</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
      <li>
        <label>要食物唧!</label>
        <description>他们竟然赶我走！我要食物唧，我还要吃的！</description>
        <baseMoodEffect>-16</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RHAH_Thought_AteFood</defName>
    <thoughtClass>HungerAndHavoc.Pawn.Thought_Memory_RHAH_FamineFed</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>有吃的吱</label>
        <description>有吃的进肚子了吱，真好。</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
      <li>
        <label>好吃吱吱!</label>
        <description>这口吃的真好吱！还想再吃一口。</description>
        <baseMoodEffect>12</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
