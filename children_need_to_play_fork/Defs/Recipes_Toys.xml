	<!-- Plush Toys -->
	<RecipeDef ParentName="TPE_CraftPlushBase">
		<defName>TPE_CraftPlushMuffalo</defName>
		<label>make stuffed muffalo</label>
		<description>Sew a fluffy stuffed muffalo toy.</description>
		<jobString>Making stuffed muffalo.</jobString>
		<workAmount>2500</workAmount>
		<skillRequirements>
			<Crafting>1</Crafting>
		</skillRequirements>
		<!-- We intentionally do NOT use <recipeUsers> here.  In RimWorld
		     standalone RecipeDefs that produce Apparel items with an
		     <unfinishedThingDef> sometimes fail to appear in the workbench
		     bill menu when bound via <recipeUsers>.  The vanilla, rock-solid
		     approach is to list the recipes in the bench ThingDef's
		     <recipes> node instead (see TPE_ToyWorkbench in
		     ThingDefs_Toys.xml).  This mirrors how TableMachining exposes
		     ButcherCorpseMechanoid. -->
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Cloth</li>
					</thingDefs>
				</filter>
				<count>25</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Cloth</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<TPE_PlushMuffalo>1</TPE_PlushMuffalo>
		</products>
	</RecipeDef>

