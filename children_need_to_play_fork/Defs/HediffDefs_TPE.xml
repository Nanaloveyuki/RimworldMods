<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>TPE_CribConfinement</defName>
    <label>crib confinement</label>
    <description>This toddler has been confined to their crib. Severity builds while awake in the crib; at maximum they will enter a mental state and demand to be let out.</description>
    <hediffClass>ToddlersPlayExpanded.Hediff_TPE_CribConfinement</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>0.001</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>1</maxSeverity>
    <alwaysShowSeverity>true</alwaysShowSeverity>

    <stages>
      <li>
        <label>content</label>
        <minSeverity>0</minSeverity>
      </li>
      <li>
        <label>restless</label>
        <minSeverity>0.001</minSeverity>
      </li>
      <li>
        <label>frustrated</label>
        <minSeverity>0.5</minSeverity>
      </li>
      <li>
        <label>wants out</label>
        <minSeverity>1.0</minSeverity>
      </li>
    </stages>
  </HediffDef>

  <!-- ========================================== -->
  <!-- WANTS OUT OF CRIB -->
  <!-- Applied after the confinement hediff reaches max severity.
       Drives crying mental state and signals caregivers to rescue.
       Times out after ~45 minutes; removing it resets the confinement cycle. -->
  <!-- ========================================== -->
  <HediffDef>
    <defName>TPE_WantsOutOfCrib</defName>
    <label>wants to be let out</label>
    <description>This toddler wants to be let out of their crib.</description>
    <hediffClass>ToddlersPlayExpanded.Hediff_TPE_WantsOutOfCrib</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>1</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>demanding</label>
        <minSeverity>0</minSeverity>
      </li>
    </stages>
  </HediffDef>

  <!-- ========================================== -->
  <!-- CRIB LOCK -->
  <!-- Player-toggleable marker; when present colonists will -->
  <!-- keep this toddler in their crib and not let them out. -->
  <!-- ========================================== -->
  <HediffDef>
    <defName>TPE_CribLocked</defName>
    <label>crib lock</label>
    <description>This toddler has been locked in their crib by the player. Colonists will not let them out and will return them to bed if they escape.</description>
    <hediffClass>ToddlersPlayExpanded.Hediff_TPE_CribLocked</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>0.5</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>locked</label>
        <minSeverity>0</minSeverity>
      </li>
    </stages>
  </HediffDef>

</Defs>
