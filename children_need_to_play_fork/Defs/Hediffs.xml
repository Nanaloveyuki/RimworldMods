<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<HediffDef>
		<defName>TPE_Running</defName>
		<label>running</label>
		<description>A temporary boost to movement speed while running around.</description>
		<hediffClass>Hediff</hediffClass>
		<isBad>false</isBad>
		<initialSeverity>1.0</initialSeverity>
		<maxSeverity>1.0</maxSeverity>
		<stages>
			<li>
				<statOffsets>
					<MoveSpeed>1.2</MoveSpeed>
				</statOffsets>
			</li>
		</stages>
	</HediffDef>

	<HediffDef>
		<defName>TPE_SnailCrawling</defName>
		<label>snail crawling</label>
		<description>Moving very slowly like a snail.</description>
		<hediffClass>Hediff</hediffClass>
		<isBad>false</isBad>
		<initialSeverity>1.0</initialSeverity>
		<maxSeverity>1.0</maxSeverity>
		<stages>
			<li>
				<statOffsets>
					<!-- Strong negative offset to push MoveSpeed down to its minValue (0.15 c/s).
						 This produces visible slow crawling (~6–7 seconds per tile). -->
					<MoveSpeed>-10</MoveSpeed>
				</statOffsets>
			</li>
		</stages>
	</HediffDef>

	<HediffDef>
		<defName>TPE_DinosaurStomp</defName>
		<label>dinosaur stomping</label>
		<description>Walking heavily like a big scary dinosaur.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<isBad>false</isBad>
		<initialSeverity>1.0</initialSeverity>
		<maxSeverity>1.0</maxSeverity>
		<comps>
			<li Class="ToddlersPlayExpanded.CompProperties_DinosaurStompSafety" />
		</comps>
		<stages>
			<li>
				<statOffsets>
					<MoveSpeed>-0.6</MoveSpeed>
				</statOffsets>
			</li>
		</stages>
	</HediffDef>

</Defs>
