		</apparel>
	</ThingDef>

	<!-- ========================================== -->
	<!-- TOY SWORD -->
	<!-- ========================================== -->
	<ThingDef ParentName="ResourceBase">
		<defName>TPE_ToySword</defName>
		<label>toy sword</label>
		<description>A small wooden sword carved for imaginative play. Perfect for slaying imaginary monsters.</description>
		<graphicData>
			<texPath>Things/Item/ToySword/ToySword</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(0.7,0.7)</drawSize>
		</graphicData>
		<stackLimit>1</stackLimit>
		<useHitPoints>true</useHitPoints>
		<statBases>
			<MaxHitPoints>40</MaxHitPoints>
			<Mass>0.4</Mass>
			<Flammability>1.0</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
			<Beauty>1</Beauty>
			<!-- USER-REQUESTED: 10 silver (was 25 — 5 logs + work is only ~11, so
			     25 made it a small wood-to-silver money loop). -->
			<MarketValue>10</MarketValue>
		</statBases>
		<thingCategories>
			<li>Toys</li>
		</thingCategories>
		<!-- Only bulk goods traders buy toys (see the plush base above). -->
		<tradeTags>
			<li>Toys</li>
		</tradeTags>
		<genericMarketSellable>false</genericMarketSellable>
		<comps>
			<li Class="CompProperties_Forbiddable"></li>
			<li Class="ToddlersPlayExpanded.CompProperties_ToyCategory">
				<categoryLabel>Imagination Toys</categoryLabel>
			</li>
		</comps>
	</ThingDef>

	<!-- ========================================== -->
	<!-- MAGNIFYING GLASS -->
	<!-- ========================================== -->
	<!-- Small telescope-like tool for examining things closely. Used during bug watching activities
	     to make the observation more interactive. Crafted from steel and glass components. -->
	<ThingDef ParentName="ResourceBase">
		<defName>TPE_MagnifyingGlass</defName>
		<label>magnifying glass</label>
		<description>A small magnifying glass used for examining tiny details. Perfect for inspecting bugs, seeds, and small objects during exploration.</description>
		<graphicData>
			<texPath>Things/Item/MagnifyingGlass/MagnifyingGlass</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(0.7,0.7)</drawSize>
		</graphicData>
		<stackLimit>1</stackLimit>
		<useHitPoints>true</useHitPoints>
		<statBases>
			<MaxHitPoints>50</MaxHitPoints>
			<Mass>0.2</Mass>
			<Flammability>0.5</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
			<Beauty>2</Beauty>
			<!-- USER-REQUESTED: 30 silver, same as the plush toys. -->
			<MarketValue>30</MarketValue>
		</statBases>
		<thingCategories>
			<li>Toys</li>
		</thingCategories>
		<!-- Only bulk goods traders buy toys (see the plush base above). Without
		     genericMarketSellable=false, exotic traders' BuyExpensiveSimple
		     generator would still buy the glass (30 silver per unit >= its 15 limit). -->
		<tradeTags>
			<li>Toys</li>
		</tradeTags>
		<genericMarketSellable>false</genericMarketSellable>
		<comps>
			<li Class="CompProperties_Forbiddable"></li>
			<li Class="ToddlersPlayExpanded.CompProperties_ToyCategory">
				<categoryLabel>Imagination Toys</categoryLabel>
			</li>
		</comps>
	</ThingDef>

</Defs>
