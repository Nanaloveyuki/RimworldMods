	<ThingDef ParentName="TPE_PlushToyBase">
		<defName>TPE_PlushFox</defName>
		<label>stuffed fox</label>
		<description>A clever orange fox with white markings and a fluffy tail. A cunning companion for curious children.</description>
		<graphicData>
			<texPath>Things/Item/ToyPlush/ToyPlushFox</texPath>
			<!-- Fox texture is intrinsically smaller in dimensions than muffalo.
			     Increase drawSize from base 0.6 to 1.0 to match visual size of other plushes.
			     This ensures the fox appears correctly scaled when lying on the ground as an item. -->
			<drawSize>(1.0,1.0)</drawSize>
		</graphicData>
		<apparel>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<careIfWornByCorpse>false</careIfWornByCorpse>
			<careIfDamaged>false</careIfDamaged>
			<developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
			<bodyPartGroups>
				<li>Torso</li>
			</bodyPartGroups>
			<layers>
				<li>Belt</li>
			</layers>
			<wornGraphicPath>Things/Item/ToyPlush/ToyPlushFox</wornGraphicPath>
			<drawData>
				<!-- Toddler scale matches other plushes and looks correct at 0.85.
				     Child scale increased by ~10% (0.85 * 1.1 = 0.935, rounded to 0.94)
				     to make equipped fox slightly more prominent when worn by children. -->
				<scale>0.85</scale>
				<childScale>0.94</childScale>
				<defaultData>
					<offset>(-0.2, 0, -0.05)</offset>
				</defaultData>
				<dataNorth>
					<offset>(0.25, 0, -0.05)</offset>
				</dataNorth>
				<dataSouth>
					<offset>(-0.25, 0, -0.05)</offset>
				</dataSouth>
