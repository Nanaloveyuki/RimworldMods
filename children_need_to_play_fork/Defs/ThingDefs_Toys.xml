<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- ThingCategory for toys -->
	<ThingCategoryDef>
		<defName>Toys</defName>
		<label>toys</label>
		<parent>Manufactured</parent>
		<iconPath>Things/Item/ToyPlush/ToyPlushTeddy</iconPath>
