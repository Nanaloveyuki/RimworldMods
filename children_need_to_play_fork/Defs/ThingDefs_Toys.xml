	<!-- ========================================== -->
	<!-- TOY WORKBENCH -->
	<!-- ========================================== -->
	<ThingDef ParentName="BenchBase">
		<defName>TPE_ToyWorkbench</defName>
		<label>toy workbench</label>
		<description>A small workbench for crafting toys and playthings for the colony's children.</description>
		<thingClass>Building_WorkTable</thingClass>
		<graphicData>
			<texPath>Things/Building/ToyWorkbench/ToyWorkbench</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1,1)</drawSize>
			<damageData>
				<rect>(0.2,0.2,0.6,0.6)</rect>
			</damageData>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<fillPercent>0.5</fillPercent>
		<useHitPoints>true</useHitPoints>
		<statBases>
			<WorkToBuild>800</WorkToBuild>
			<MaxHitPoints>100</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<Cleanliness>-2</Cleanliness>
			<WorkTableWorkSpeedFactor>0.9</WorkTableWorkSpeedFactor>
			<Mass>10</Mass>
		</statBases>
		<costList>
			<WoodLog>30</WoodLog>
			<Steel>10</Steel>
		</costList>
		<size>(1,1)</size>
		<designationCategory>Production</designationCategory>
		<hasInteractionCell>true</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<surfaceType>Item</surfaceType>
		<inspectorTabs>
			<li>ITab_Bills</li>
		</inspectorTabs>
		<building>
			<spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
			<paintable>true</paintable>
			<workTableRoomRole>Workshop</workTableRoomRole>
			<workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
		</building>
		<!-- Explicit recipe list for this bench.  Vanilla uses this pattern
		     (e.g. TableMachining lists ButcherCorpseMechanoid here) when a
		     recipe should appear on exactly one workbench.  We do this for
		     ALL toy recipes because standalone RecipeDefs with
		     <recipeUsers> fail to show up for apparel-type products. -->
		<recipes>
			<li>TPE_CraftPlushMuffalo</li>
			<li>TPE_CraftPlushTeddy</li>
			<li>TPE_CraftPlushSheep</li>
			<li>TPE_CraftPlushDino</li>
			<li>TPE_CraftPlushMonster</li>
			<li>TPE_CraftPlushFox</li>
			<li>TPE_CraftToySword</li>
			<li>TPE_CraftMagnifyingGlass</li>
		</recipes>
		<comps>
			<!-- CompProperties_ReportWorkSpeed is inherited from BenchBase; do NOT duplicate it here. -->
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
					<li>ToolCabinet</li>
				</linkableFacilities>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
	</ThingDef>

	<!-- ========================================== -->
	<!-- PLUSH TOYS -->
	<!-- ========================================== -->
	<ThingDef Abstract="True" Name="TPE_PlushToyBase" ParentName="ResourceBase">
		<thingClass>Apparel</thingClass>
		<label>plush toy</label>
		<description>A soft stuffed toy for children to play with. Toddlers can wear them to bed for comfort.</description>
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(0.6,0.6)</drawSize>
		</graphicData>
		<stackLimit>1</stackLimit>
		<useHitPoints>true</useHitPoints>
		<statBases>
			<MaxHitPoints>50</MaxHitPoints>
			<Mass>0.3</Mass>
			<Flammability>1.2</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
			<Beauty>2</Beauty>
			<EquipDelay>0.5</EquipDelay>
			<!-- USER-REQUESTED: every plush toy is worth 30 silver (deliberately
			     below its cloth + work cost, about 38-51, to discourage crafting toys
			     for profit). Set ONCE here on the abstract base; the individual
			     plush defs no longer override it. An explicit MarketValue also means
			     vanilla never has to derive the value by scanning every RecipeDef
			     (StatWorker_MarketValue.CalculableRecipe). -->
			<MarketValue>30</MarketValue>
		</statBases>
		<thingCategories>
			<li>Toys</li>
		</thingCategories>
		<!-- Selling rules (user-requested): ONLY bulk goods traders buy toys. The
		     "Toys" tag is what Patches/TraderKinds_BulkGoods_BuyToys.xml buys;
		     genericMarketSellable=false keeps every other trader's catch-all
		     "buy expensive items" generator from buying them. -->
		<tradeTags>
			<li>Toys</li>
		</tradeTags>
		<genericMarketSellable>false</genericMarketSellable>
		<apparel>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<careIfWornByCorpse>false</careIfWornByCorpse>
			<careIfDamaged>false</careIfDamaged>
			<developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
			<bodyPartGroups>
				<li>Torso</li>
			</bodyPartGroups>
			<layers>
				<li>Belt</li>
			</layers>
		</apparel>
		<comps>
			<li Class="CompProperties_Forbiddable"></li>
			<li Class="ToddlersPlayExpanded.CompProperties_ToyCategory">
				<categoryLabel>Plush toys</categoryLabel>
			</li>
		</comps>
	</ThingDef>

