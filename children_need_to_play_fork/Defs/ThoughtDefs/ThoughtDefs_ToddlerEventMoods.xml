    <!-- ── POSITIVE events ── -->

    <ThoughtDef>
        <defName>TPE_Event_RainStarted</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.125</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>Its raining! Its raining!</label>
                <description>Water is falling from the sky! Its all drippy and splishy! I wanna go splash in the puddles! Rain is so fun!</description>
                <baseMoodEffect>3</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

