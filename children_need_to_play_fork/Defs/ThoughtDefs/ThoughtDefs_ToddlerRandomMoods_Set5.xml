<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  SET 5 — POSITIVE random toddler moods (+1 to +10)             -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <ThoughtDef>
        <defName>TPE_RandomMoodPos_1_5</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.3</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I found a surprise candy!</label>
                <description>I found a little candy hidden somewhere! It was a secret surprise just for me! I ate it quick before anyone saw! It was so sweet and yummy!</description>
                <baseMoodEffect>1</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodPos_2_5</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.5</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I blew a dandelion!</label>
                <description>I found a fluffy dandelion and blew it really hard! All the little seeds went flying everywhere like tiny parachutes! I made a wish and everything!</description>
                <baseMoodEffect>2</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodPos_3_5</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.7</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>My socks are fuzzy!</label>
                <description>Im wearing the fuzziest softest socks ever! My toes feel like theyre wrapped in little clouds! Every step is all squishy and warm! I love fuzzy socks!</description>
                <baseMoodEffect>3</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodPos_4_5</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.9</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I did a somersault!</label>
                <description>I did a real somersault! I tucked my head and rolled all the way over! The world went upside down! I landed on my feet! Im basically an acrobat!</description>
                <baseMoodEffect>4</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodPos_5_5</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.1</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>Everyone clapped for me!</label>
                <description>I did something and everyone started clapping! Clap clap clap! It was for me! I felt so proud! My face got all warm and smiley!</description>
                <baseMoodEffect>5</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodPos_6_5</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.3</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I found a smooth stone!</label>
                <description>I found the smoothest roundest stone ever! It fits perfectly in my hand! I keep rubbing it because it feels so nice! This is my lucky stone!</description>
                <baseMoodEffect>6</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodPos_7_5</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.5</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I remembered a whole song!</label>
                <description>I remembered every single word of a song! Even the tricky parts! I sang it all the way through without messing up! My brain is so big and smart!</description>
                <baseMoodEffect>7</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodPos_8_5</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.7</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I flew like an aeroplane!</label>
                <description>Someone lifted me up and zoomed me around like an aeroplane! Neeeeeeow! I was flying! My arms were the wings! I want to be a pilot when I grow up!</description>
                <baseMoodEffect>8</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodPos_9_5</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.9</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I saw sparkly fireworks!</label>
                <description>There were sparkly lights exploding in the sky! Boom crackle pop! They were every colour! I covered my ears but I kept watching! It was so pretty!</description>
                <baseMoodEffect>9</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodPos_10_5</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>2.1</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I had the best dream ever!</label>
                <description>I had a dream where everything was made of candy and I could fly! I ate a cloud and it tasted like marshmallow! I didnt wanna wake up! Best dream ever!</description>
                <baseMoodEffect>10</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  SET 5 — NEGATIVE random toddler moods (-1 to -10)             -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <ThoughtDef>
        <defName>TPE_RandomMoodNeg_1_5</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.3</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>My ears went pop...</label>
                <description>My ears went all poppy and weird! Everything sounds funny and far away! I tried to wiggle my jaw but they wont unpopped! Its so annoying!</description>
                <baseMoodEffect>-1</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodNeg_2_5</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.5</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I got a zap!</label>
                <description>I touched something and it went ZAP! A shock went through my finger! It hurt and tingled! Now Im scared to touch anything metal!</description>
                <baseMoodEffect>-2</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodNeg_3_5</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.7</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I spilled my drink...</label>
                <description>I was holding my drink and it tipped over and spilled everywhere! Its all over my clothes and the floor! Now Im thirsty and wet! I didnt mean to!</description>
                <baseMoodEffect>-3</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodNeg_4_5</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.9</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I tripped over nothing!</label>
                <description>I was walking just fine and then I tripped! There was nothing there! My own feet betrayed me! Now my knee hurts and I feel silly...</description>
                <baseMoodEffect>-4</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodNeg_5_5</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.1</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>They laughed at me...</label>
                <description>I did something and people laughed but not the nice laugh... It was the mean kind... I dont know what I did wrong... My eyes are all watery now...</description>
                <baseMoodEffect>-5</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodNeg_6_5</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.3</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I couldnt reach it...</label>
                <description>There was something I really wanted on a high shelf and I stretched and stretched but I couldnt reach it! No one would help me! It was right there!</description>
                <baseMoodEffect>-6</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodNeg_7_5</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.5</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>Someone pushed me...</label>
                <description>Someone pushed me and I almost fell over! They didnt even say sorry! My shoulder hurts where they shoved me! That was mean! I didnt do anything!</description>
                <baseMoodEffect>-7</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodNeg_8_5</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.7</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I saw a scary person...</label>
                <description>There was someone with a scary face and mean eyes... They looked at me and I got all cold inside... I hid behind the closest grown up... Please dont let them get me...</description>
                <baseMoodEffect>-8</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodNeg_9_5</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.9</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I threw up...</label>
                <description>My tummy went all weird and then I threw up! It came out of my mouth and it was gross and warm! Now my throat burns and everything smells bad! I hate throwing up!</description>
                <baseMoodEffect>-9</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodNeg_10_5</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>2.1</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I had a terrible nightmare!</label>
                <description>I had a scary dream and everything was dark and monsters were chasing me! I woke up crying and my heart is still pounding! What if I have it again! I dont wanna sleep!</description>
                <baseMoodEffect>-10</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

</Defs>
