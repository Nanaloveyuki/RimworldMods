<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  SET 1 — POSITIVE random toddler moods (+1 to +10)             -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <ThoughtDef>
        <defName>TPE_RandomMoodPos_1_1</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.3</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>Something smelled nice!</label>
                <description>I smelled something really really nice! It was all flowery and sweet! I took a big sniff and it made me smile!</description>
                <baseMoodEffect>1</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodPos_2_1</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.5</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I saw a pretty colour!</label>
                <description>I saw the most prettiest colour ever! It was so bright and beautiful! I wanna paint everything that colour!</description>
                <baseMoodEffect>2</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodPos_3_1</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.7</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>The floor is bouncy!</label>
                <description>I was walking and the floor felt all bouncy and fun! Boing boing boing! It made me giggle so much!</description>
                <baseMoodEffect>3</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodPos_4_1</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.9</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I made a funny face!</label>
                <description>I made the silliest funniest face in the mirror! My nose went all wiggly and my eyes went big! I looked so silly!</description>
                <baseMoodEffect>4</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodPos_5_1</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.1</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I got a piggyback!</label>
                <description>Someone gave me a piggyback ride! I was up so high! I could see everything! It was like I was flying! Wheeeeee!</description>
                <baseMoodEffect>5</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodPos_6_1</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.3</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>My toy made a noise!</label>
                <description>My toy went squeak squeak when I squeezed it! It was the funniest noise! I kept doing it over and over! Squeak!</description>
                <baseMoodEffect>6</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodPos_7_1</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.5</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I counted to five!</label>
                <description>I counted all the way to five! One, two, three, four, five! I did it all by myself! Im the smartest toddler ever!</description>
                <baseMoodEffect>7</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodPos_8_1</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.7</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I found a secret spot!</label>
                <description>I found a super secret hiding spot! No one could find me! I was invisible! It was my special place just for me!</description>
                <baseMoodEffect>8</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodPos_9_1</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.9</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I danced to music!</label>
                <description>There was music playing and I danced and danced! I spun around and around! My feet went tap tap tap! I love dancing!</description>
                <baseMoodEffect>9</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodPos_10_1</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>2.1</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>Everyone loves me!</label>
                <description>Everyone gave me hugs and kisses! They said Im their favourite little person! I feel so warm and happy inside! I love everyone too!</description>
                <baseMoodEffect>10</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  SET 1 — NEGATIVE random toddler moods (-1 to -10)             -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <ThoughtDef>
        <defName>TPE_RandomMoodNeg_1_1</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.3</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>My sock is twisted!</label>
                <description>My sock is all twisted and bunched up inside my shoe! Its all lumpy and uncomfortable! I tried to fix it but I cant reach!</description>
                <baseMoodEffect>-1</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodNeg_2_1</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.5</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I got a little wet...</label>
                <description>Something splashed on me and now Im all wet... My sleeve is drippy and cold... I dont like being wet...</description>
                <baseMoodEffect>-2</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodNeg_3_1</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.7</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>My voice went crackly...</label>
                <description>I tried to yell really loud but my voice went all crackly and weird... It didnt sound right... Now my throat feels funny...</description>
                <baseMoodEffect>-3</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodNeg_4_1</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.9</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>The chair is too hard...</label>
                <description>Im sitting on this chair and its all hard and pokey... Its not comfy at all... I wanna sit on something soft instead...</description>
                <baseMoodEffect>-4</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodNeg_5_1</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.1</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I saw a spooky shadow...</label>
                <description>There was a big spooky shadow on the wall and it moved! I got scared and hid! What if its a monster... I dont like shadows...</description>
                <baseMoodEffect>-5</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodNeg_6_1</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.3</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>My drawing got ruined...</label>
                <description>I was drawing a picture and someone bumped my arm! Now theres a big scribble where I didnt want it! My picture is ruined! I worked so hard...</description>
                <baseMoodEffect>-6</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodNeg_7_1</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.5</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>The food tastes wrong...</label>
                <description>I took a bite of my food and it tastes all weird and wrong... Its supposed to be yummy but its not... I dont wanna eat it anymore...</description>
                <baseMoodEffect>-7</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodNeg_8_1</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.7</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I got left behind...</label>
                <description>Everyone walked away really fast and I couldnt keep up! I tried to run but they were too far! I was all alone and scared...</description>
                <baseMoodEffect>-8</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodNeg_9_1</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1.9</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>A loud noise scared me...</label>
                <description>There was a super duper loud BANG and it made me jump! My heart is beating super fast! I dont like loud noises... They scare me...</description>
                <baseMoodEffect>-9</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TPE_RandomMoodNeg_10_1</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>2.1</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I had a scary thought!</label>
                <description>I thought of something really really scary and now I cant stop thinking about it! What if theres monsters under my bed! What if they come get me! I dont wanna be alone!</description>
                <baseMoodEffect>-10</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  ADOPTION-SPECIFIC situational thought (separate from random)  -->
    <!--  Applies persistently to toddlers with no parent in colony.    -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <ThoughtDef>
        <defName>TPE_AdoptedToddlerHomesick</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>2.0</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby,Child</developmentalStageFilter>
        <stages>
            <li>
                <label>I miss my old home...</label>
                <description>I keep thinking about my old home and my old friends... Everything here is different and strange... I just wanna go back... I miss them so much...</description>
                <baseMoodEffect>-10</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

</Defs>
