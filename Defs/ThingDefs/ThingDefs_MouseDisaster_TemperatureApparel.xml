<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef Name="MouseDisasterTemperatureApparelBase" ParentName="ApparelBase" Abstract="True">
    <thingClass>Apparel</thingClass>
    <techLevel>Neolithic</techLevel>
    <smeltable>false</smeltable>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/TribalA/TribalA</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.9</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>45</MaxHitPoints>
      <Mass>0.1</Mass>
    </statBases>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <apparel>
      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <!-- 这是只提供保温数值的应急层，不参与 PawnRenderTree，避免依赖身体阶段/种族的服饰贴图。 -->
      <layers>
        <li>OnSkin</li>
      </layers>
      <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
  </ThingDef>

  <ThingDef ParentName="MouseDisasterTemperatureApparelBase">
    <defName>MouseDisaster_Heat_StaleWetCloth</defName>
    <label>陈旧的湿布</label>
    <description>搭在身上的吸水布，也不知道用了多久。虽然能降温呢，但都这么热了，活着最重要。</description>
    <statBases>
      <Insulation_Heat>8</Insulation_Heat>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="MouseDisasterTemperatureApparelBase">
    <defName>MouseDisaster_Heat_DryMudCoating</defName>
    <label>干硬的厚泥巴涂层</label>
    <description>贴在身上很难受，但最起码可以起到降温的作用。</description>
    <statBases>
      <Insulation_Heat>12</Insulation_Heat>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="MouseDisasterTemperatureApparelBase">
    <defName>MouseDisaster_Heat_ReedShadeWrap</defName>
    <label>芦苇遮阳裹布</label>
    <description>用干芦苇编成的松散裹布。勉强算是衣服，却能挡住阳光，也能让热气透出去。</description>
    <statBases>
      <Insulation_Heat>20</Insulation_Heat>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="MouseDisasterTemperatureApparelBase">
    <defName>MouseDisaster_Heat_SoakedBarkWrap</defName>
    <label>浸水的树皮遮热衣</label>
    <description>浸过水的树皮条绑在身上，味道糟透了，但至少能让最初那段酷热好受一些。</description>
    <statBases>
      <Insulation_Heat>28</Insulation_Heat>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="MouseDisasterTemperatureApparelBase">
    <defName>MouseDisaster_Heat_MudReedMantle</defName>
    <label>泥芦降温披</label>
    <description>泥巴和芦苇压成的厚垫子。又丑、又湿，却意外地能在烈日下派上用场。</description>
    <statBases>
      <Insulation_Heat>36</Insulation_Heat>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="MouseDisasterTemperatureApparelBase">
    <defName>MouseDisaster_Heat_HeavyCoolingMud</defName>
    <label>厚重的降温泥壳</label>
    <description>身上糊了好几层晒干的泥巴。每次活动都会裂开，但能挡住难以忍受的高温。</description>
    <statBases>
      <Insulation_Heat>44</Insulation_Heat>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="MouseDisasterTemperatureApparelBase">
    <defName>MouseDisaster_Cold_ThinHempLayer</defName>
    <label>单层麻布保暖层</label>
    <description>一小片粗糙的麻布，虽然不顶什么用，但总比光着身子好。</description>
    <statBases>
      <Insulation_Cold>8</Insulation_Cold>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="MouseDisasterTemperatureApparelBase">
    <defName>MouseDisaster_Cold_LayeredHempClothes</defName>
    <label>层层麻布织成的保暖衣物</label>
    <description>最原始的办法做出来的麻布，尽管不好看，但足够保暖了。</description>
    <statBases>
      <Insulation_Cold>12</Insulation_Cold>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="MouseDisasterTemperatureApparelBase">
    <defName>MouseDisaster_Cold_StrawBarkQuilt</defName>
    <label>草梗树皮絮衣</label>
    <description>干草梗和树皮缝在旧布中间，走动时嘎吱作响，却能留住一点宝贵的热气。</description>
    <statBases>
      <Insulation_Cold>20</Insulation_Cold>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="MouseDisasterTemperatureApparelBase">
    <defName>MouseDisaster_Cold_PatchedFurCloak</defName>
    <label>拼接毛皮短披</label>
    <description>用毛皮碎片拼成的短披风，接缝处都开了，味道也不好，但风不容易直接灌进来。</description>
    <statBases>
      <Insulation_Cold>28</Insulation_Cold>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="MouseDisasterTemperatureApparelBase">
    <defName>MouseDisaster_Cold_SmokeStiffenedBlanket</defName>
    <label>烟熏油硬的旧毯</label>
    <description>被烟和油脂熏硬的旧毯子，粗糙又脏，却能把寒气挡在外面。</description>
    <statBases>
      <Insulation_Cold>40</Insulation_Cold>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="MouseDisasterTemperatureApparelBase">
    <defName>MouseDisaster_Cold_ThickHideHempWrap</defName>
    <label>厚皮麻布裹衣</label>
    <description>几层兽皮和麻布绑在身上，不会妨碍关键活动，保暖效果却比看起来好得多。</description>
    <statBases>
      <Insulation_Cold>56</Insulation_Cold>
    </statBases>
  </ThingDef>
</Defs>
