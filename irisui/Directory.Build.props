<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == '' and '$(OS)' == 'Windows_NT'">E:/Apps/Steam/steamapps/common/RimWorld</RimWorldManagedDir>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == ''">/mnt/e/Apps/Steam/steamapps/common/RimWorld</RimWorldManagedDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../1.7/Assemblies/</OutputPath>
    <DebugType>none</DebugType>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.1" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp;UnityStubs;RimWorld;Waylith;Waylith.UnityCompat;Brutal.Core.Numerics;Brutal.Core.Strings;Brutal.Core.Common;Brutal.Core.Maths">
      <HintPath>$(RimWorldManagedDir)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
