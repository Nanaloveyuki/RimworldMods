<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.7</RimWorldVersion>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.6'">net48</TargetFramework>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
    <RimWorldManagedDir Condition="'$(RimWorldVersion)' == '1.7' and '$(RimWorldManagedDir)' == '' and '$(OS)' == 'Windows_NT'">E:/Apps/Steam/steamapps/common/RimWorld</RimWorldManagedDir>
    <RimWorldManagedDir Condition="'$(RimWorldVersion)' == '1.7' and '$(RimWorldManagedDir)' == ''">/mnt/e/Apps/Steam/steamapps/common/RimWorld</RimWorldManagedDir>
    <DefineConstants Condition="'$(RimWorldVersion)' == '1.7'">$(DefineConstants);RIMWORLD_1_7</DefineConstants>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Source/IrisMenus.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(RimWorldVersion)' == '1.6' and '$(RimWorldManagedDir)' == ''">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4633" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(RimWorldVersion)' == '1.6' and '$(RimWorldManagedDir)' != ''">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="$(RimWorldManagedDir)/UnityEngine*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(RimWorldVersion)' == '1.7'">
    <RimWorldReference Include="Assembly-CSharp;UnityStubs;RimWorld;Waylith;Brutal.Core.Numerics" />
    <Reference Include="@(RimWorldReference)">
      <HintPath>$(RimWorldManagedDir)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
