<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>LeadYourPet_DragBruise</defName>
    <label>拖行淤伤</label>
    <description>反复拖行留下的轻微擦伤与淤伤。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.10</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>7500~7500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <label>拖行淤伤</label>
        <painOffset>0.02</painOffset>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>LeadYourPet_DragSlow</defName>
    <label>被拖拽</label>
    <description>正在被拖拽，移动明显变慢。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.01</initialSeverity>
    <stages>
      <li>
        <label>被拖拽</label>
        <statFactors>
          <MoveSpeed>0.9</MoveSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
</Defs>
