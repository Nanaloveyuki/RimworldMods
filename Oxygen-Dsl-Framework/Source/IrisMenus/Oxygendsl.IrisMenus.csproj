<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Oxygendsl.IrisMenus</AssemblyName>
    <RootNamespace>Oxygendsl.IrisMenus</RootNamespace>
    <OutputPath>../../tmp/build/1.7/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <IrisMenusSourceDir Condition="'$(IrisMenusSourceDir)' == ''">../../../IrisMenus</IrisMenusSourceDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Oxygendsl.Core.csproj" Private="false" />
    <ProjectReference Include="../Mod/Oxygendsl.Mod.csproj" Private="false" />
    <Reference Include="IrisMenus"><HintPath>$(IrisMenusSourceDir)/1.7/Assemblies/IrisMenus.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldManagedDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorldManagedDir)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../docs/Oxygen/zh_cn/*.md" LogicalName="docs.Oxygen.zh_cn.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
