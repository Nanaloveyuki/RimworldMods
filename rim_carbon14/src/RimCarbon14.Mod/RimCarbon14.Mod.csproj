<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RimCarbon14</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <Target Name="CheckGame" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameVersion)' != '1.7'" Text="Current sources target RimWorld 1.7. Package the preserved 1.6 runtime without rebuilding it." />
    <Error Condition="!Exists('$(GameManaged)/Assembly-CSharp.dll') or !Exists('$(GameManaged)/UnityStubs.dll')" Text="Set RIMWORLD_DIR or -p:RimWorldDir to an installed RimWorld 1.7 directory containing Assembly-CSharp.dll and UnityStubs.dll." />
    <Error Condition="!Exists('$(HarmonyPath)')" Text="Set -p:HarmonyPath to the installed Harmony 3 1.7/Assemblies/0Harmony.dll." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="../RimCarbon14.Core/RimCarbon14.Core.csproj" />
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManaged)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(GameManaged)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
