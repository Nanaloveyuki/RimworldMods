<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>AdvancedRimTalk</RootNamespace>
    <AssemblyName>AdvancedRimTalk</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputPath>tmp\build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <IrisMenusDll Condition="'$(IrisMenusDll)' == ''">$(MSBuildThisFileDirectory)../iris_menus/1.7/Assemblies/IrisMenus.dll</IrisMenusDll>
    <DefineConstants Condition="Exists('$(IrisMenusDll)')">$(DefineConstants);ART_IRISMENUS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**;tmp\**;obj\**" />
    <EmbeddedResource Include="docs\references\Arti\zh_cn\**\*.md" Link="docs\Arti\zh_cn\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldAssemblyDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldAssemblyDir)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimTalk">
      <HintPath>$(RimTalkAssemblyDir)\RimTalk.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Scriban">
      <HintPath>$(RimTalkAssemblyDir)\Scriban.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="IrisMenus" Condition="Exists('$(IrisMenusDll)')">
      <HintPath>$(IrisMenusDll)</HintPath>
      <Aliases>iris</Aliases>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
