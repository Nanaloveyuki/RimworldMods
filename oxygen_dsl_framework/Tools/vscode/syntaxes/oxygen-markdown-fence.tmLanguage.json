{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Oxygen fenced code blocks in Markdown",
  "scopeName": "source.oxygen.markdown.fence",
  "injectionSelector": "L:markup.fenced_code.block.markdown",
  "patterns": [
    {
      "include": "#oxygen-code-block"
    }
  ],
  "repository": {
    "oxygen-code-block": {
      "begin": "(?<=[`~])(?i:oxygen|oxy)(\\s+[^`~]*)?$",
      "end": "(^|\\G)(?=\\s*[`~]{3,}\\s*$)",
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.oxygen",
          "patterns": [
            {
              "include": "source.oxygen"
            }
          ]
        }
      ]
    }
  }
}
