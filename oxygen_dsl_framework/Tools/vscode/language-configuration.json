{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "/*", "close": " */", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "wordPattern": "[^\\s`~!@#$%^&*()=+\\[\\]{}\\\\|;:\"',.<>/?-]+|[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?",
  "indentationRules": {
    "increaseIndentPattern": "(?=\\{[^}\"']*(?://.*)?$)",
    "decreaseIndentPattern": "^\\s*\\}"
  }
}
