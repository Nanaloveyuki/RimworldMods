<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.7</RimWorldVersion>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.6'">net48</TargetFramework>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
    <RimWorldManagedDir Condition="'$(RimWorldVersion)' == '1.7' and '$(RimWorldManagedDir)' == '' and '$(OS)' == 'Windows_NT'">E:/Apps/Steam/steamapps/common/RimWorld</RimWorldManagedDir>
    <RimWorldManagedDir Condition="'$(RimWorldVersion)' == '1.7' and '$(RimWorldManagedDir)' == ''">/mnt/e/Apps/Steam/steamapps/common/RimWorld</RimWorldManagedDir>
    <RimWorldManagedDir Condition="'$(RimWorldVersion)' == '1.6' and '$(RimWorldManagedDir)' == '' and '$(OS)' == 'Windows_NT'">E:/Apps/Steam/steamapps/common/RimWorld/RimWorldWin64_Data/Managed</RimWorldManagedDir>
    <RimWorldManagedDir Condition="'$(RimWorldVersion)' == '1.6' and '$(RimWorldManagedDir)' == ''">/mnt/e/Apps/Steam/steamapps/common/RimWorld/RimWorldWin64_Data/Managed</RimWorldManagedDir>
    <RimIrisAssemblyPath Condition="'$(RimIrisAssemblyPath)' == '' and '$(OS)' == 'Windows_NT'">E:/Apps/Steam/steamapps/common/RimWorld/Mods/3796735623/Assemblies/RimIris.dll</RimIrisAssemblyPath>
    <RimIrisAssemblyPath Condition="'$(RimIrisAssemblyPath)' == ''">/mnt/e/Apps/Steam/steamapps/common/RimWorld/Mods/3796735623/Assemblies/RimIris.dll</RimIrisAssemblyPath>
    <DefineConstants Condition="'$(RimWorldVersion)' == '1.7'">$(DefineConstants);RIMWORLD_1_7</DefineConstants>
    <AssemblyName>RimIrisShaders.UI</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath Condition="'$(RimWorldVersion)' == '1.6'">../Assemblies/</OutputPath>
    <OutputPath Condition="'$(RimWorldVersion)' == '1.7'">../1.7/Assemblies/</OutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup Condition="'$(RimWorldVersion)' == '1.6'">
    <RimWorldReference Include="Assembly-CSharp;UnityEngine.CoreModule;UnityEngine.IMGUIModule;UnityEngine.TextRenderingModule" />
  </ItemGroup>
  <ItemGroup Condition="'$(RimWorldVersion)' == '1.7'">
    <RimWorldReference Include="Assembly-CSharp;UnityStubs;RimWorld;Waylith;Waylith.UnityCompat;Brutal.Core.Common;Brutal.Core.Collections;Brutal.Core.Logging;Brutal.Core.Maths;Brutal.Core.Memory;Brutal.Core.Numerics;Brutal.Core.Strings;Brutal.Glfw;Brutal.Gltf;Brutal.ImGui;Brutal.Interop;Brutal.Slang;Brutal.Texture;Brutal.Vulkan;Brutal.Vulkan.Abstractions;Brutal.Vulkan.Vma" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="@(RimWorldReference)">
      <HintPath>$(RimWorldManagedDir)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimIris"><HintPath>$(RimIrisAssemblyPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckRimWorldReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RimWorldVersion)' != '1.6' and '$(RimWorldVersion)' != '1.7'" Text="RimWorldVersion must be 1.6 or 1.7." />
    <Error Condition="!Exists('$(RimWorldManagedDir)/%(RimWorldReference.Identity).dll')" Text="Missing RimWorld $(RimWorldVersion) assembly: $(RimWorldManagedDir)/%(RimWorldReference.Identity).dll. Set RimWorldManagedDir to the installed DLL directory for that version, not decompiled source." />
    <Error Condition="!Exists('$(RimIrisAssemblyPath)')" Text="Missing RimIris assembly: $(RimIrisAssemblyPath). Set RimIrisAssemblyPath to RimIris.dll." />
  </Target>
</Project>
