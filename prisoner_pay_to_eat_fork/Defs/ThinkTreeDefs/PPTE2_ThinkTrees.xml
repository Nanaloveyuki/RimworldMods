<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Built-in prisoner labour: injected into every humanlike's think tree after the duty slot
    (same vanilla insertTag mechanism Prison Labor and Biotech use). The gate node rejects
    non-prisoners and prisoners who shouldn't work, so this is a no-op for everyone else.
    Inside, prisoners reuse the vanilla colonist pattern: needs (food/rest/joy) outrank work
    via the priority sorter, JobGiver_Work does the actual work scanning (our Harmony postfix
    on PawnCanUseWorkGiver whitelists work-enabled prisoners for the allowed work types).
    JobGiver_SeekAllowedArea comes first so an allowed-area assignment is enforced.
  -->
  <ThinkTreeDef>
    <defName>PPTE2_PrisonerWork</defName>
    <insertTag>Humanlike_PostDuty</insertTag>
    <insertPriority>80</insertPriority>
    <thinkRoot Class="PrisonersPayToEat2.ThinkNode_PrisonerWorkGate">
      <subNodes>
        <li Class="JobGiver_SeekAllowedArea"/>
        <li Class="ThinkNode_Tagger">
          <tagToGive>SatisfyingNeeds</tagToGive>
          <subNodes>
            <li Class="ThinkNode_PrioritySorter">
              <subNodes>
                <li Class="JobGiver_GetFood"/>
                <li Class="JobGiver_GetRest"/>
                <!-- 必须用原版包装节点：裸的 JobGiver_GetJoy 没有 GetPriority 实现，
                     PrioritySorter 会打红字并跳过（原版殖民者树同款写法） -->
                <li Class="ThinkNode_Priority_GetJoy">
                  <subNodes>
                    <li Class="JobGiver_GetJoy"/>
                    <li Class="JobGiver_GetJoyInBed"/>
                  </subNodes>
                </li>
                <li Class="JobGiver_Work"/>
              </subNodes>
            </li>
          </subNodes>
        </li>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <!--
    牢房自动索要饭票：没钱且牢房内有通讯台的囚犯会自己走过去向所属派系索要。
    独立于劳工系统的子树（劳工系统关闭时也能用），insertPriority 79 排在工作子树之前。
    Gate 节点自己挡掉非囚犯/有钱/冷却中/崩溃/越狱的人，空开销极小。
  -->
  <ThinkTreeDef>
    <defName>PPTE2_PrisonerRequests</defName>
    <insertTag>Humanlike_PostDuty</insertTag>
    <insertPriority>79</insertPriority>
    <thinkRoot Class="PrisonersPayToEat2.ThinkNode_RequestTicketsGate">
      <subNodes>
        <li Class="PrisonersPayToEat2.JobGiver_RequestTickets"/>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>
</Defs>
