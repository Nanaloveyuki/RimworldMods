<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>PrisonersPayToEat2</RootNamespace>
    <AssemblyName>PrisonersPayToEat2</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
    <OutputPath>../1.7/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <WarningLevel>4</WarningLevel>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(RimWorldDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(RimWorldDir)/UnityStubs.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(HarmonyAssemblyPath)" Private="false" />
  </ItemGroup>
  <Target Name="CheckRimWorldReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RimWorldVersion)' != '1.7'" Text="This project builds RimWorld 1.7 only. The 1.6 release is immutable." />
    <Error Condition="!Exists('$(RimWorldDir)/Assembly-CSharp.dll') or !Exists('$(RimWorldDir)/UnityStubs.dll')" Text="Set RimWorldDir to the RimWorld 1.7 game root." />
    <Error Condition="!Exists('$(HarmonyAssemblyPath)')" Text="Set HarmonyAssemblyPath to Harmony 3's 1.7/Assemblies/0Harmony.dll." />
    <GetAssemblyIdentity AssemblyFiles="$(RimWorldDir)/Assembly-CSharp.dll">
      <Output TaskParameter="Assemblies" ItemName="RimWorldIdentity" />
    </GetAssemblyIdentity>
    <GetAssemblyIdentity AssemblyFiles="$(HarmonyAssemblyPath)">
      <Output TaskParameter="Assemblies" ItemName="HarmonyIdentity" />
    </GetAssemblyIdentity>
    <Error Condition="!$([System.String]::Copy('%(RimWorldIdentity.Version)').StartsWith('1.7.'))" Text="Assembly-CSharp.dll must be the RimWorld 1.7 implementation." />
    <Error Condition="!$([System.String]::Copy('%(HarmonyIdentity.Version)').StartsWith('3.'))" Text="The RimWorld 1.7 build requires Harmony 3, not a legacy Harmony assembly." />
  </Target>

  <ItemGroup>
    <Compile Remove="Tests/**/*.cs;tests/**/*.cs;obj/**/*.cs;bin/**/*.cs" />
    <EmbeddedResource Remove="Tests/**/*;tests/**/*" />
    <None Remove="Tests/**/*;tests/**/*" />
  </ItemGroup>
</Project>