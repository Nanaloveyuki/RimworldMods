  <RecipeDef ParentName="SurgeryFlesh">
    <defName>PPTE2_RemoveOtherOrgan</defName>
    <label>remove organ for tickets</label>
    <description>Surgically remove a clean, harvestable internal organ in exchange for 30 meal tickets. Only organs whose removal is not predicted to be directly fatal are available. Each organ type may be sold only once per prisoner. Surgery can still fail, injure or kill the patient.</description>
