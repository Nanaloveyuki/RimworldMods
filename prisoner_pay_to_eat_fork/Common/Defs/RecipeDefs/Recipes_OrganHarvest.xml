  <LetterDef ParentName="CustomChoiceLetterBase">
    <defName>PPTE2_OrganSaleRequest</defName>
    <letterClass>PrisonersPayToEat2.ChoiceLetter_OrganSale</letterClass>
  </LetterDef>

</Defs>