<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--Natural anatomy is rechecked immediately before surgery; surgical failure remains possible.-->
  <RecipeDef ParentName="SurgeryFlesh">
    <defName>PPTE2_RemoveKidney</defName>
    <label>remove kidney for tickets</label>
    <description>Surgically remove one of the prisoner's kidneys in exchange for 40 meal tickets. Only one kidney per prisoner can be sold, and another kidney must remain. Current health is checked before removal, but surgery can still fail, injure or kill the patient.</description>
    <workerClass>PrisonersPayToEat2.RecipeWorker_OrganSale</workerClass>
    <jobString>harvesting kidney for tickets</jobString>
    <workAmount>2500</workAmount>
    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    <appliedOnFixedBodyParts>
      <li>Kidney</li>
    </appliedOnFixedBodyParts>
    <surgerySuccessChanceFactor>1</surgerySuccessChanceFactor>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Medicine</li>
      </categories>
    </fixedIngredientFilter>
  </RecipeDef>

