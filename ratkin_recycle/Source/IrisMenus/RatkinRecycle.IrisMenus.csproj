<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>RatkinRecycle.IrisMenus</AssemblyName>
    <RootNamespace>RatkinRecycle.IrisMenus</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputPath>../../1.7/IrisMenus/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <IrisMenusAssemblyPath Condition="'$(IrisMenusAssemblyPath)' == ''">$(MSBuildThisFileDirectory)../../../iris_menus/1.7/Assemblies/IrisMenus.dll</IrisMenusAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RatkinRecycle.csproj" Private="false" />
    <Reference Include="IrisMenus" HintPath="$(IrisMenusAssemblyPath)" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(RimWorldDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(RimWorldDir)/UnityStubs.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckOptionalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RimWorldVersion)' != '1.7'" Text="The optional IrisMenus adapter only supports RimWorld 1.7." />
    <Error Condition="!Exists('$(IrisMenusAssemblyPath)')" Text="Set IrisMenusAssemblyPath to the IrisMenus 1.7 assembly." />
  </Target>
</Project>
