<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <Target Name="CheckGame" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameVersion)' != '1.7'" Text="The current development fixture targets RimWorld 1.7 only." />
    <Error Condition="!Exists('$(GameManaged)/Assembly-CSharp.dll') or !Exists('$(GameManaged)/UnityStubs.dll') or !Exists('$(HarmonyPath)')" Text="Set RimWorldDir and HarmonyPath to the installed RimWorld 1.7 and Harmony 3 assemblies." />
  </Target>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManaged)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(GameManaged)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
