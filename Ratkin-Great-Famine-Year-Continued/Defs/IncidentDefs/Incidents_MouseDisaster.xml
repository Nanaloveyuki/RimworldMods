<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <IncidentDef>
    <defName>MouseDisaster_LargeRefugeeWave</defName>
    <label>大型流民冲击</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>MouseDisaster.IncidentWorker_LargeRefugeeWave</workerClass>
    <letterLabel>大型流民冲击</letterLabel>
    <letterText>一大群饿疯了的鼠族涌向殖民地。它们不打算战斗，只想找吃的，吃饱后便会陆续离开。</letterText>
    <letterDef>NeutralEvent</letterDef>
    <baseChance>0.12</baseChance>
    <category>Misc</category>
    <pointsScaleable>true</pointsScaleable>
  </IncidentDef>

  <IncidentDef>
    <defName>MouseDisaster_AbandonedRatkinChildren</defName>
    <label>鼠蛋遗弃</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>MouseDisaster.IncidentWorker_AbandonedRatkinChildren</workerClass>
    <letterLabel>鼠蛋遗弃</letterLabel>
    <letterText>一只鼠族带着一群鼠蛋闯入地图边缘，径直朝储粮处走去。耗子妈会等鼠蛋全部到位后撤离，这些鼠蛋随后会变成游荡的野生鼠族。</letterText>
    <letterDef>NeutralEvent</letterDef>
    <baseChance>0.15</baseChance>
    <category>Misc</category>
    <pointsScaleable>true</pointsScaleable>
  </IncidentDef>

  <IncidentDef>
    <defName>MouseDisaster_ShatteredMother</defName>
    <label>耗子分妈</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>MouseDisaster.IncidentWorker_ShatteredMother</workerClass>
    <letterLabel>耗子分妈</letterLabel>
    <letterText>地图边缘倒着一只濒死的鼠族。与此同时，一群鼠蛋正穿过殖民地，像什么都没发生一样继续往前走。</letterText>
    <letterDef>NeutralEvent</letterDef>
    <baseChance>0.12</baseChance>
    <category>Misc</category>
    <pointsScaleable>true</pointsScaleable>
  </IncidentDef>

  <IncidentDef>
    <defName>MouseDisaster_BeggarFamily</defName>
    <label>乞讨的灾荒鼠妈</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>MouseDisaster.IncidentWorker_BeggarFamily</workerClass>
    <letterLabel>乞讨的灾荒鼠妈</letterLabel>
    <letterText>一位母亲带着四个鼠蛋来到殖民地边缘。她们不打算战斗，只想求一口吃的。</letterText>
    <letterDef>NeutralEvent</letterDef>
    <baseChance>0.18</baseChance>
    <category>Misc</category>
    <pointsScaleable>false</pointsScaleable>
  </IncidentDef>

  <IncidentDef>
    <defName>MouseDisaster_BeggarGroup</defName>
    <label>乞讨的鼠族队伍</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>MouseDisaster.IncidentWorker_BeggarGroup</workerClass>
    <letterLabel>乞讨的鼠族队伍</letterLabel>
    <letterText>一支饥饿的鼠族流民来到殖民地。它们会先尝试向殖民者乞食，若始终求不到食物，就会自己去找。</letterText>
    <letterDef>NeutralEvent</letterDef>
    <baseChance>0.22</baseChance>
    <category>Misc</category>
    <pointsScaleable>true</pointsScaleable>
  </IncidentDef>

  <IncidentDef>
    <defName>MouseDisaster_ThiefRatkinGroup</defName>
    <label>偷窃的鼠族</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>MouseDisaster.IncidentWorker_ThiefRatkinGroup</workerClass>
    <letterLabel>偷窃的鼠族</letterLabel>
    <letterText>一帮饥饿的鼠族偷偷摸进了殖民地。它们现在只是在找食物，但你也可以立刻把这批家伙收留或驱赶成敌对。</letterText>
    <letterDef>NeutralEvent</letterDef>
    <baseChance>0.35</baseChance>
    <category>Misc</category>
    <pointsScaleable>true</pointsScaleable>
  </IncidentDef>

  <IncidentDef>
    <defName>MouseDisaster_ThiefRatkinChildGroup</defName>
    <label>偷窃的鼠蛋</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>MouseDisaster.IncidentWorker_ThiefRatkinChildGroup</workerClass>
    <letterLabel>偷窃的鼠蛋</letterLabel>
    <letterText>一群鼠蛋溜进了殖民地，正一边偷吃一边顺手带走食物。你也可以立刻把这批家伙收留或驱赶成敌对。</letterText>
    <letterDef>NeutralEvent</letterDef>
    <baseChance>0.22</baseChance>
    <category>Misc</category>
    <pointsScaleable>true</pointsScaleable>
  </IncidentDef>

  <IncidentDef>
    <defName>MouseDisaster_WildRatkinWandersIn</defName>
    <label>游荡的野生鼠族</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>MouseDisaster.IncidentWorker_WildRatkinWandersIn</workerClass>
    <letterLabel>游荡的野生鼠族</letterLabel>
    <letterText>一只看起来饿极了的野生鼠族出现在地图上。它没有派系，能像原版野人一样被驯服。</letterText>
    <letterDef>NeutralEvent</letterDef>
    <baseChance>0.25</baseChance>
    <category>Misc</category>
    <pointsScaleable>false</pointsScaleable>
  </IncidentDef>

  <IncidentDef>
    <defName>MouseDisaster_WildRatkinChildWandersIn</defName>
    <label>游荡的野生鼠蛋</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>MouseDisaster.IncidentWorker_WildRatkinChildWandersIn</workerClass>
    <letterLabel>游荡的野生鼠蛋</letterLabel>
    <letterText>一只看起来饿极了的野生鼠蛋出现在地图上。它没有派系，能像原版野人一样被驯服。</letterText>
    <letterDef>NeutralEvent</letterDef>
    <baseChance>0.2</baseChance>
    <category>Misc</category>
    <pointsScaleable>false</pointsScaleable>
  </IncidentDef>

  <IncidentDef>
    <defName>MouseDisaster_WildRatkinGroupWandersIn</defName>
    <label>游荡的野生鼠群</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>MouseDisaster.IncidentWorker_WildRatkinGroupWandersIn</workerClass>
    <letterLabel>游荡的野生鼠群</letterLabel>
    <letterText>一群饥饿的野生鼠族出现在地图边缘。它们没有派系，会像原版野人一样在地图上活动。</letterText>
    <letterDef>NeutralEvent</letterDef>
    <baseChance>0.16</baseChance>
    <category>Misc</category>
    <pointsScaleable>true</pointsScaleable>
  </IncidentDef>

  <IncidentDef>
    <defName>MouseDisaster_FamineRefugees</defName>
    <label>灾荒逃难者</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>MouseDisaster.IncidentWorker_FamineRefugees</workerClass>
    <letterLabel>灾荒逃难者</letterLabel>
    <letterText>几名被灾荒逼得走投无路的鼠族来到殖民地边缘，祈求加入。他们瘦得吓人，但至少还活着。</letterText>
    <letterDef>PositiveEvent</letterDef>
    <baseChance>0.14</baseChance>
    <category>Misc</category>
    <pointsScaleable>true</pointsScaleable>
  </IncidentDef>

  <IncidentDef>
    <defName>MouseDisaster_RatkinTraderCaravan</defName>
    <label>流民商队</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>MouseDisaster.IncidentWorker_RatkinTraderCaravan</workerClass>
    <letterLabel>流民商队</letterLabel>
    <letterText>一名鼠族商贩牵着一串囚犯鼠蛋来到殖民地边缘。商贩负责交涉，这些鼠蛋会按囚犯交易处理。</letterText>
    <letterDef>PositiveEvent</letterDef>
    <baseChance>0.1</baseChance>
    <category>Misc</category>
    <pointsScaleable>true</pointsScaleable>
  </IncidentDef>

  <IncidentDef>
    <defName>MouseDisaster_ChildExchange</defName>
    <label>易子而食</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>MouseDisaster.IncidentWorker_ChildExchange</workerClass>
    <letterLabel>易子而食</letterLabel>
    <letterText>一名鼠族商贩牵着一串鼠蛋来到殖民地边缘。请派殖民者前去交涉，选择用殖民者、囚犯或奴隶婴儿交换；若 24 小时内未成交，对方会离开。</letterText>
    <letterDef>NeutralEvent</letterDef>
    <baseChance>0.08</baseChance>
    <category>Misc</category>
    <pointsScaleable>false</pointsScaleable>
  </IncidentDef>

  <IncidentDef>
    <defName>MouseDisaster_BeggarSiege</defName>
    <label>鼠灾围攻</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>MouseDisaster.IncidentWorker_MouseDisasterSiege</workerClass>
    <letterLabel>鼠灾围攻</letterLabel>
    <letterText>一群鼠灾流民包围了你的殖民地。它们不会主动攻击，但会反复乞讨食物。它们只有在身上拥有 5 份食物，或偷吃到 1 份食物后才会离开。</letterText>
    <letterDef>NeutralEvent</letterDef>
    <baseChance>0.1</baseChance>
    <category>Misc</category>
    <pointsScaleable>false</pointsScaleable>
  </IncidentDef>

</Defs>
