<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>MouseDisaster_FedOnce</defName>
    <label>已吃饱</label>
    <description>已完成本次鼠灾访客的寻食目标。</description>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>1</initialSeverity>
    <stages><li><becomeVisible>false</becomeVisible></li></stages>
  </HediffDef>

  <HediffDef>
    <defName>MouseDisaster_RefeedingSyndrome</defName>
    <label>再喂养综合征</label>
    <description>机体长期缺乏糖类供能，短时间内大量进食后，胰岛素水平上升，引起血清电解质失衡。消化、血液滤毒和意识暂时下降。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120000~300000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li><capacity>Metabolism</capacity><offset>-0.30</offset></li>
          <li><capacity>BloodFiltration</capacity><offset>-0.20</offset></li>
          <li><capacity>Consciousness</capacity><offset>-0.25</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>MouseDisaster_GnawedTreeBark</defName>
    <label>啃食树皮</label>
    <description>粗糙树皮划伤了口腔和消化道。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>0.2</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>90000~90000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <painOffset>0.15</painOffset>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>MouseDisaster_GnawedWall</defName>
    <label>啃食墙皮</label>
    <description>墙灰与碎屑让身体暂时维持住了，但代价并不轻。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>0.2</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>90000~90000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <painOffset>0.35</painOffset>
        <hungerRateFactor>0.5</hungerRateFactor>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>MouseDisaster_OverGnawedWall</defName>
    <label>过量啃食墙皮</label>
    <description>墙灰堵住了身体本能，几乎把这具小身体彻底拖垮。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>0.3</initialSeverity>
    <stages>
      <li>
        <painOffset>0.8</painOffset>
        <statFactors>
          <MaxNutrition>0.1</MaxNutrition>
        </statFactors>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.6</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>MouseDisaster_TemporaryShelterMark</defName>
    <label>鼠灾临时收留</label>
    <description>这名鼠灾访客目前正被殖民地临时收留。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <isBad>false</isBad>
    <comps>
      <li Class="MouseDisaster.HediffCompProperties_MouseDisasterEmploymentTimer">
        <disappearsAfterTicks>60000~60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>MouseDisaster_HiredWorkerMark</defName>
    <label>鼠灾长工</label>
    <description>这名鼠灾访客目前以长工身份留在殖民地。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <isBad>false</isBad>
    <comps>
      <li Class="MouseDisaster.HediffCompProperties_MouseDisasterEmploymentTimer">
        <disappearsAfterTicks>60000~60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>MouseDisaster_DisasterRefugeeMark</defName>
    <label>鼠灾难民</label>
    <description>这名鼠族来自大荒年灾荒，是因饥荒而流离失所的灾民。它们饥饿、瘦弱，正在寻求食物和庇护。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>0</severityPerDay>
      </li>
    </comps>
  </HediffDef>
</Defs>
