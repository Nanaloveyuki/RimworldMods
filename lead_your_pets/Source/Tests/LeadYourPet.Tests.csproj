<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == '' and '$(RIMWORLD_VERSION)' != ''">$(RIMWORLD_VERSION)</RimWorldVersion>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.7</RimWorldVersion>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.6'">net472</TargetFramework>
    <DefineConstants Condition="'$(RimWorldVersion)' == '1.7'">$(DefineConstants);RIMWORLD_1_7</DefineConstants>
    <DefineConstants Condition="'$(RimWorldVersion)' == '1.6'">$(DefineConstants);RIMWORLD_1_6</DefineConstants>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <RimWorldDir Condition="'$(RimWorldDir)' == '' and '$(RIMWORLD_DIR)' != ''">$(RIMWORLD_DIR)</RimWorldDir>
    <RimWorldDir Condition="'$(RimWorldDir)' == '' and '$(RimWorldVersion)' == '1.7' and '$(OS)' == 'Windows_NT'">E:/Apps/Steam/steamapps/common/RimWorld</RimWorldDir>
    <RimWorldDir Condition="'$(RimWorldDir)' == '' and '$(RimWorldVersion)' == '1.7'">/mnt/e/Apps/Steam/steamapps/common/RimWorld</RimWorldDir>
  </PropertyGroup>

  <Target Name="EnsureRimWorldDir" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RimWorldVersion)' != '1.6' and '$(RimWorldVersion)' != '1.7'" Text="RimWorldVersion must be 1.6 or 1.7." />
    <Error Condition="'$(RimWorldDir)' == ''" Text="RimWorldDir is not set. Pass /p:RimWorldDir=PATH or set RIMWORLD_DIR." />
    <Error Condition="'$(RimWorldVersion)' == '1.7' and (!Exists('$(RimWorldDir)/Assembly-CSharp.dll') or !Exists('$(RimWorldDir)/UnityStubs.dll'))" Text="RimWorld 1.7 tests require the installed game-root Assembly-CSharp.dll and UnityStubs.dll, and the .NET 10 SDK/runtime." />
    <Error Condition="'$(RimWorldVersion)' == '1.6' and !Exists('$(RimWorldDir)/RimWorldWin64_Data/Managed/Assembly-CSharp.dll')" Text="An explicit 1.6 test build requires a separate RimWorld 1.6 installation." />
  </Target>

  <ItemGroup Condition="'$(RimWorldVersion)' == '1.7'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)/Assembly-CSharp.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)/UnityStubs.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(RimWorldVersion)' == '1.6'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)/RimWorldWin64_Data/Managed/Assembly-CSharp.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldDir)/RimWorldWin64_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LeadYourPet.csproj" AdditionalProperties="RimWorldVersion=$(RimWorldVersion);RimWorldDir=$(RimWorldDir)" />
  </ItemGroup>

</Project>
