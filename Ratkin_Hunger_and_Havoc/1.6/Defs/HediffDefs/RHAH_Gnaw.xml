<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>RHAH_GnawedBark</defName>
    <label>啃食树皮</label>
    <description>啃食粗糙树皮时划伤了口腔和消化道，造成疼痛。伤口过一阵会自行恢复。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>0.2</initialSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>90000~90000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <painOffset>0.15</painOffset>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>RHAH_GnawedWall</defName>
    <label>啃食墙皮</label>
    <description>吃下的墙灰和碎屑暂时减缓了饥饿，却也划伤了口腔，造成较重的疼痛。这些症状过一阵会自行消退。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>0.2</initialSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>90000~90000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <painOffset>0.35</painOffset>
        <hungerRateFactor>0.5</hungerRateFactor>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>RHAH_OvergnawedWall</defName>
    <label>过量啃食墙皮</label>
    <description>吃进太多墙灰，造成剧烈疼痛和意识下降，能吃下的食物也大幅减少。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>0.3</initialSeverity>
    <isBad>true</isBad>
    <stages>
      <li>
        <painOffset>0.8</painOffset>
        <statFactors>
          <MaxNutrition>0.1</MaxNutrition>
        </statFactors>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.6</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
