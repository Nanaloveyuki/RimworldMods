<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/StatDef[defName="Insulation_Cold" or defName="Insulation_Heat"]/parts</xpath>
    <value>
      <li Class="HungerAndHavoc.Pawn.StatPart_RHAH_TemperatureApparel" />
    </value>
  </Operation>
