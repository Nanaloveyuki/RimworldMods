<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>HungerAndHavoc</AssemblyName>
    <RootNamespace>HungerAndHavoc</RootNamespace>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../1.6/Assemblies/</OutputPath>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>
  <PropertyGroup>
    <RimWorldDir Condition="'$(RimWorldDir)' == '' and '$(RIMWORLD_DIR)' != ''">$(RIMWORLD_DIR)</RimWorldDir>
    <OxygenDslDir Condition="'$(OxygenDslDir)' == ''">$(MSBuildThisFileDirectory)../../Oxygen-Dsl-Framework</OxygenDslDir>
  </PropertyGroup>
  <Target Name="EnsureRimWorldDir" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RimWorldDir)' == ''" Text="RimWorldDir is not set. Pass /p:RimWorldDir=PATH or set RIMWORLD_DIR." />
  </Target>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>HungerAndHavoc.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.1">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />

    <Compile Remove="Api\**\*.cs" />
    <EmbeddedResource Remove="Tests\**\*" />
    <None Remove="Tests\**\*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Api\HungerAndHavoc.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="EventMgr/RHAH_EventFollow.oxy" LogicalName="HungerAndHavoc.EventMgr.RHAH_EventFollow.oxy" />
    <EmbeddedResource Include="EventMgr/RHAH_PredationArrival.oxy" LogicalName="HungerAndHavoc.EventMgr.RHAH_PredationArrival.oxy" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Oxygendsl.Core">
      <HintPath>$(OxygenDslDir)/tmp/build/Oxygendsl.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Oxygendsl.Mod">
      <HintPath>$(OxygenDslDir)/tmp/build/Oxygendsl.Mod.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)\RimWorldWin64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldDir)\RimWorldWin64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldDir)\RimWorldWin64_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldDir)\RimWorldWin64_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldDir)\RimWorldWin64_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <IrisMenusDll>$(RimWorldDir)\Mods\IrisMenus\1.6\Assemblies\IrisMenus.dll</IrisMenusDll>
  </PropertyGroup>
  <ItemGroup Condition="!Exists('$(IrisMenusDll)')">
    <Compile Remove="Pawn\Compat\RHAH_IrisMenusCompat.cs" />
    <Compile Remove="Pawn\Compat\RHAH_IrisMenusWidgets.cs" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(IrisMenusDll)')">
    <ReferencePath Include="$(IrisMenusDll)">
      <Aliases>iris</Aliases>
    </ReferencePath>
  </ItemGroup>
  <PropertyGroup Condition="Exists('$(IrisMenusDll)')">
    <DefineConstants>$(DefineConstants);RHAH_IRISMENUS</DefineConstants>
  </PropertyGroup>

</Project>
