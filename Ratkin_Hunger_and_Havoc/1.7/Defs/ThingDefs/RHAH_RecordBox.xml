<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>RHAH_RecordBox</defName>
    <label>旧箱子</label>
    <description>一只还能盖上盖子的旧木箱，里面放着搬运清单、配给记录和一叠受潮的纸。</description>
    <thingClass>HungerAndHavoc.Storyteller.Suiyin.Building_RHAH_RecordBox</thingClass>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>50</pathCost>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>1</Flammability>
      <WorkToBuild>0</WorkToBuild>
    </statBases>
    <graphicData>
      <texPath>Things/Building/Ruins/AncientCrate</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <rotatable>false</rotatable>
    <building>
      <isEdifice>true</isEdifice>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
    </building>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
  </ThingDef>
  <ThingDef ParentName="ResourceBase">
    <defName>RHAH_MigrationRecord</defName>
    <label>搬运记录</label>
    <description>几页粘在一起的清单。上面的数量被改过两遍，最后一次没有签名。</description>
    <graphicData>
      <texPath>Things/Item/Book/Textbook/Textbook</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>1</stackLimit>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <MarketValue>0</MarketValue>
      <Mass>0.2</Mass>
      <Flammability>1</Flammability>
    </statBases>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <tradeability>None</tradeability>
  </ThingDef>
</Defs>
