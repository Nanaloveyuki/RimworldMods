<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef ParentName="InfectionBase">
    <defName>RHAH_Plague</defName>
    <label>鼠疫</label>
    <description>一种在拥挤、饥饿的鼠族中传播的疫病。患者会发热、虚弱，病情恶化可能致死。接触患者可能受到感染。</description>
    <makesSickThought>true</makesSickThought>
    <lethalSeverity>1</lethalSeverity>
    <tendable>true</tendable>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>12</baseTendDurationHours>
        <severityPerDayTended>-0.0773</severityPerDayTended>
      </li>
      <li Class="HediffCompProperties_Immunizable">
        <severityPerDayNotImmune>0.33588</severityPerDayNotImmune>
        <immunityPerDaySick>0.2388</immunityPerDaySick>
        <severityPerDayImmune>-0.4947</severityPerDayImmune>
        <immunityPerDayNotSick>-0.06</immunityPerDayNotSick>
      </li>
    </comps>
    <stages>
      <li>
        <label>轻微</label>
        <painOffset>0.15</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.05</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.05</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>严重</label>
        <painOffset>0.35</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.85</minSeverity>
        <label>危重</label>
        <lifeThreatening>true</lifeThreatening>
        <painOffset>0.6</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.25</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.25</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.25</offset>
          </li>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.99</minSeverity>
        <label>无法行动</label>
        <lifeThreatening>false</lifeThreatening>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
